# Copy to .env — docker compose reads this automatically.

# GitHub personal access token (public_repo scope). Raises the rate limit to
# 5,000 req/hour. Without it you're capped at 60/hour.
GITHUB_TOKEN=

# SEC EDGAR requires a User-Agent containing a contact email, else funding
# lookups get 403. Defaults to the owner's email if unset.
SEC_USER_AGENT=gitinvest funding scout dogukangundogan5@gmail.com
