# Copy to .env and fill in your GitHub personal access token.
# A classic token with public_repo scope (or a fine-grained token with public
# repo read access) is enough. Raises the rate limit to 5,000 requests/hour.
GITHUB_TOKEN=

# Funding data comes from SEC EDGAR (free). SEC's archive REQUIRES a
# User-Agent containing a contact email or it returns 403. Set yours:
SEC_USER_AGENT=gitinvest dogukangundogan5@gmail.com

# Optional overrides:
# DATABASE_URL=sqlite:///./gitinvest.db
# DEFAULT_MIN_STARS=500
# DEFAULT_MAX_STARS=15000
# REFRESH_HOUR=4
